# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# Tool caches
.pytest_cache/
.ruff_cache/

# Generated raw runs, including caches, shards, frozen snapshots and downloads.
# Source connectomes under Connectome/ remain versioned.
/results/
/final_results/
/logs/
/*.out
/*.err
/*.log

# Generated analysis/figure outputs stay local. Keep source scripts and reports.
/analysis/**
!/analysis/**/
!/analysis/**/*.py
!/analysis/**/*.sh
!/analysis/**/*.sbatch
!/analysis/**/*.R
!/analysis/**/*.jl
!/analysis/**/*.md
/analysis/**/cache/
/analysis/**/snapshot/
/analysis/**/code_snapshot/
/analysis/**/sources/
/analysis/**/default_plan/

/architecture_variant_figures/**
!/architecture_variant_figures/**/
!/architecture_variant_figures/**/*.py
!/architecture_variant_figures/**/*.md
/metric_figures/**
!/metric_figures/**/
!/metric_figures/**/*.py
!/metric_figures/**/*.md

# Local environments and packaging output
.venv/
venv/
/build/
/dist/
*.egg-info/
.ipynb_checkpoints/
.mypy_cache/
.coverage
htmlcov/
.DS_Store
*.merge.tmp
